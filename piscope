#!/usr/bin/env python3
"""PiScope compatibility shim — all launch logic lives in start.py.

Kept so the documented ``piscope`` command, existing notes and cron entries
continue to work.  Prefer ``python3 start.py`` when a plain Python entry point
is convenient.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from start import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
